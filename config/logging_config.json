{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "detailed": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    },
    "simple": {
      "format": "%(levelname)s - %(message)s"
    }
  },
  "handlers": {
    "agent_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "logs/agents/agent_execution.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "formatter": "detailed"
    },
    "executor_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "logs/executors/executor_performance.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "formatter": "detailed"
    },
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "simple"
    }
  },
  "loggers": {
    "agents.executors": {
      "handlers": [
        "agent_file",
        "console"
      ],
      "level": "INFO",
      "propagate": false
    },
    "agents.executor_registry": {
      "handlers": [
        "executor_file",
        "console"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}