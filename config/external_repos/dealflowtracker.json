      {
        "type": "deny_git_push",
        "unless": "explicit_operator_approval"
      },
      {
        "type": "deny_git_tag",
        "unless": "explicit_operator_approval"
      },
      {
        "type": "deny_git_force",
        "always": true
      },
      {
        "type": "deny_paths",
