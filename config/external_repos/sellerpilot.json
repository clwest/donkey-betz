      "CLAUDE.md",
      "00-START-NEXT-SESSION.md"
    ],
    "ports": {
      "frontend": 5177,
      "backend": 8005,
      "websocket": null,
      "notes": "Vite/nginx host :5177 \u2192 container :80 (web). FastAPI uvicorn :8005 (api). Updated Session 1125 Docker fleet rollout."
    },
    "start_commands": {
      "backend": "cd backend && source .venv/bin/activate && uvicorn app.main:app --host localhost --port 8005 --reload",
      "frontend": "cd frontend && npm run dev -- --port 5177 --strictPort"
    }
  },
  "protected_paths": [
    ".env",
    ".env.*",
    "**/.env*",
    "**/*.pem",
    "**/*key*",
    "**/credentials*",
    "**/.ssh/**",
    ".git",
    ".git/",
    "backend/.venv",
    "backend/.venv/**",
    "frontend/node_modules",
    "frontend/node_modules/**",
    "frontend/dist",
    "frontend/dist/**",
    "**/__pycache__/**",
    "*.sqlite3",
    "media/"
  ],
  "permissions": {
    "allow_file_write": true,
    "allow_file_delete": false,
    "allow_command_execution": true,
    "allow_git_operations": true,
    "allow_autonomous_writes": false,
    "require_human_review": false
  },
  "repo_profile_metadata": {
    "constraints_text": [
      "No pushes / tags without explicit operator approval. No --force ever.",
      "Render API Blueprint queued \u2014 backend not yet deployed; frontend is live on Vercel.",
      "Demo-mode fallback must stay deterministic \u2014 never call OpenAI when no key configured."
    ],
    "constraints_rules": [
      {
        "type": "deny_git_push",
        "unless": "explicit_operator_approval"
      },
      {
        "type": "deny_git_tag",
        "unless": "explicit_operator_approval"
      },
      {
        "type": "deny_git_force",
        "always": true
      },
      {
        "type": "deny_paths",
        "globs": [
          ".env*",
          "**/.env*",
          "media/**"
        ]
      }
    ],
    "session_log_pointer": "docs/handoffs/",
    "fleet_role": {
      "role": "lab",
      "lab_position": "X (Optimize arc)",
      "pillar": "Innovation",
      "status": "demo-ready",
      "substatus": "Frontend Live",
      "url": "https://sellerpilot-mu.vercel.app",
      "founder_toolkit_triplet": "sellerpilot \u00b7 signal-studio \u00b7 compliancesentinel (coordinated build, coordinated pause)"
    },
    "bridge_relationship": null,
    "open_questions": [],
    "last_refresh_at": null,
    "last_git_head": null,
    "last_branch": null,
    "health_status": null,
    "snapshot_retention": {
      "max_snapshots": 20,
      "max_age_days": 30
    }
  },
  "docker": {
    "enabled": true,
    "primary_service": "web",
    "base_urls": {
      "web_url": "http://localhost:5177",
      "api_url": "http://localhost:8005"
    },
    "host_ports": {
      "web": 5177,
      "api": 8005
    },
    "container_ports": {
      "web": 80,
      "api": 8005
    },
    "container_names": {
      "web": "sellerpilot_web",
      "api": "sellerpilot_api",
      "postgres": "sellerpilot_postgres"
    },
    "fleet_net_hostnames": {
      "web": "sellerpilot_web:80",
      "api": "sellerpilot_api:8005",
      "postgres": "sellerpilot_postgres:5432"
    },
    "healthchecks": {
      "web": {
        "method": "GET",
        "path": "/",
        "expect_status": [
          200,
          304
        ],
        "notes": "nginx static root"
      },
      "api": {
        "method": "GET",
        "path": "/api/health",
        "expect_status": [
          200
        ]
      }
    },
    "brain_bridge": {
      "url": "http://localhost:8005/api/brain/ask",
      "callable_from": [
        "host",
        "fleet_net"
      ],
      "requires_auth": true,
      "auth_mode": "demo_user",
      "demo_user": {
        "email": "demo@sellerpilot.dev",
        "password": "demo123"
      }
    },
    "compose_files": [
      "docker-compose.yml",
      "docker-compose.dev.yml"
    ],
    "env_files": [
      ".env",
      ".env.example"
    ],
    "depends_on_services": [
      "postgres"
    ],
    "bootstrap_commands": {
      "direct": "cd ~/development/sellerpilot && docker compose up -d --build",
      "via_infra_make": "cd ~/development/infra && make up-app APP=sellerpilot"
    },
    "notes": [
      "Web container runs nginx with the built Vite bundle (host :5177 \u2192 container :80).",
      "API container runs uvicorn directly (host :8005 \u2192 container :8005).",
      "Postgres is internal-only; reachable on fleet-net as sellerpilot_postgres:5432.",
      "Brain bridge requires auth; demo creds are documented publicly in README."
    ]
  }
}
