    "react_version": "19",
    "database": "sqlite",
    "llm": "openai",
    "billing": "stripe-stubbed",
    "deploy_target": "vercel+render",
    "package_managers": {
      "python": "pip",
      "js": "pnpm"
    },
    "products_24_7_slug": "sellerpilot",
    "products_24_7_no": "X",
    "url": "https://sellerpilot-mu.vercel.app",
    "repo_remote": "https://github.com/clwest/sellerpilot",
    "demo_login": "demo@sellerpilot.dev / demo123"
  },
  "entry_points": {
    "anchor_narrative": "docs/PROJECT_WHAT_IT_IS.md",
    "anchor_runtime": "docs/SELLER_PILOT_INVENTORY.md",
    "anchor_start": "00-START-NEXT-SESSION.md",
    "anchor_claude": "CLAUDE.md",
    "docs_root": "docs/",
