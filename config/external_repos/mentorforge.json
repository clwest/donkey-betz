{
  "schema_version": 1,
  "repo_id": "mentorforge",
  "name": "mentorforge",
  "description": "Mentor Forge (Suite I — `arc: Mentor`, pillar Impact). Eight AI mentor personas × seven session modes (freeform, code review, system design, mock interview, guided lessons, debugging, build planning). Compounds into a Founder Project that flows into the rest of the 24/7 Global AI Suite — briefs Pitch Deck Forge, prefills Contract Concierge agreements, seeds Deal Flow Tracker. Pricing Free → $99/mo. Live at https://mentorforge.vercel.app.",
  "root_path": "/Users/donkeyking/development/mentorforge",
  "workspace_type": "local",
  "tech_stack": {
    "primary_language": "python",
    "repo_type": "saas_app",
    "backend": "fastapi",
    "frontend": "react+vite",
    "react_version": "19",
    "database": "postgres",
    "llm": "openai",
    "billing": "stripe",
    "deploy_target": "vercel+render",
    "package_managers": {"python": "pip", "js": "pnpm"},
    "products_24_7_slug": "mentorforge",
    "products_24_7_no": "I"
  },
  "entry_points": {
    "anchor_narrative": "docs/PROJECT_WHAT_IT_IS.md",
    "anchor_runtime": "docs/CONTEXT_KIT_INVENTORY.md",
    "anchor_start": "00-START-NEXT-SESSION.md",
    "anchor_claude": "CLAUDE.md",
    "docs_root": "docs/",
    "handoffs_dir": "docs/handoffs/",
    "code_allowlist": ["backend", "frontend/src", "scripts"],
    "docs_allowlist": ["docs", "README.md", "CLAUDE.md", "00-START-NEXT-SESSION.md"],
    "inventory_command": "context-kit inventory --write",
    "inventory_cwd": ".",
    "ports": {
      "frontend": 5174,
      "backend": 8002,
      "websocket": null,
      "notes": "Vite :5174 / nginx :5174 (host) → :80 (container web), FastAPI uvicorn :8002. Updated Session 1125 Docker fleet rollout."
    },
    "start_commands": {
      "backend": "cd backend && source .venv/bin/activate && uvicorn app.main:app --host localhost --port 8002 --reload",
      "frontend": "cd frontend && npm run dev -- --port 5174 --strictPort"
    }
  },
  "docker": {
    "enabled": true,
    "primary_service": "web",
    "base_urls": {
      "web_url": "http://localhost:5174",
      "api_url": "http://localhost:8002"
    },
    "host_ports": {"web": 5174, "api": 8002},
    "container_ports": {"web": 80, "api": 8002},
    "container_names": {
      "web": "mentorforge_web",
      "api": "mentorforge_api",
      "postgres": "mentorforge_postgres"
    },
    "fleet_net_hostnames": {
      "web": "mentorforge_web:80",
      "api": "mentorforge_api:8002",
      "postgres": "mentorforge_postgres:5432"
    },
    "healthchecks": {
      "web": {"method": "GET", "path": "/", "expect_status": [200, 304], "notes": "nginx static root"},
      "api": {"method": "GET", "path": "/api/health", "expect_status": [200]}
    },
    "brain_bridge": {
      "url": "http://localhost:8002/api/brain/ask",
      "callable_from": ["host", "fleet_net"],
      "requires_auth": true,
      "auth_mode": "demo_user",
      "demo_user": {"email": "demo@mentorforge.dev", "password": "demo123"}
    },
    "compose_files": ["docker-compose.yml", "docker-compose.dev.yml"],
    "env_files": [".env", ".env.example"],
    "depends_on_services": ["postgres"],
    "bootstrap_commands": {
      "direct": "cd ~/development/mentorforge && docker compose up -d --build",
      "via_infra_make": "cd ~/development/infra && make up-app APP=mentorforge"
    },
    "notes": [
      "Web container runs nginx with the built Vite bundle (host :5174 → container :80).",
      "API container runs uvicorn directly (host :8002 → container :8002).",
      "Postgres is internal-only (no host port); reachable on fleet-net as mentorforge_postgres:5432.",
      "Brain bridge endpoint is on the API service; demo creds are documented publicly in README."
    ]
  },
  "protected_paths": [
    ".env", ".env.*", "**/.env*", "**/*.pem", "**/*key*", "**/credentials*", "**/.ssh/**",
    ".git", ".git/", "backend/.venv", "backend/.venv/**", "frontend/node_modules",
    "frontend/node_modules/**", "frontend/dist", "frontend/dist/**", "**/__pycache__/**",
    "*.sqlite3", "backend/data/", "media/"
  ],
  "permissions": {
    "allow_file_write": true, "allow_file_delete": false, "allow_command_execution": true,
    "allow_git_operations": true, "allow_autonomous_writes": false, "require_human_review": false
  },
  "repo_profile_metadata": {
    "constraints_text": [
      "No pushes to remotes without explicit operator approval. No tagging without approval. No --force ever.",
      "Stripe + OpenAI keys live in .env — never commit, never echo, never expose in logs.",
      "Frontend deploys to Vercel; backend to Render. Don't push deploys without approval."
    ],
    "constraints_rules": [
      {"type": "deny_git_push", "unless": "explicit_operator_approval"},
      {"type": "deny_git_tag", "unless": "explicit_operator_approval"},
      {"type": "deny_git_force", "always": true},
      {"type": "deny_paths", "globs": [".env*", "**/.env*", "backend/data/**", "media/**"]}
    ],
    "session_log_pointer": "docs/handoffs/",
    "fleet_role": {
      "role": "suite_product",
      "suite_position": "I (first Suite product, Mentor arc)",
      "pillar": "Impact",
      "url": "https://mentorforge.vercel.app",
      "status": "shipped",
      "income_lane": true,
      "canonical_for": "React 19 + FastAPI reference template across the Suite"
    },
    "bridge_relationship": null,
    "open_questions": [], "last_refresh_at": null, "last_git_head": null,
    "last_branch": null, "health_status": null,
    "snapshot_retention": {"max_snapshots": 20, "max_age_days": 30}
  }
}
