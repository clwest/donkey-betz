# Canonical deploy template for Railway.
# Copy these values into Railway's environment settings and treat this file as
# the source of truth for Railway deployment variables.
# Shared runtime settings should match `.env.example` where applicable.

# =============================================================================
# RAILWAY ENVIRONMENT VARIABLES TEMPLATE
# Unified Donkey Betz Platform
# =============================================================================
# Variables using ${{Service.VARIABLE}} syntax reference Railway service variables.
# =============================================================================

# =============================================================================
# CORE DJANGO SETTINGS (Required)
# =============================================================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<GENERATE_NEW_SECRET_KEY>

DEBUG=False
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=core.settings

# Railway domains - update with your actual Railway URL
ALLOWED_HOSTS=.railway.app,.up.railway.app

# =============================================================================
# DATABASE (PostgreSQL - Railway Plugin)
# =============================================================================
# After adding PostgreSQL plugin, use Railway's variable reference:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# =============================================================================
# REDIS (Railway Plugin)
# =============================================================================
# After adding Redis plugin, use Railway's variable references:
REDIS_URL=redis://${{Redis.REDISHOST}}:${{Redis.REDISPORT}}/0
REDIS_CACHE_URL=redis://${{Redis.REDISHOST}}:${{Redis.REDISPORT}}/1

# Celery broker and result backend
CELERY_BROKER_URL=redis://${{Redis.REDISHOST}}:${{Redis.REDISPORT}}/2
CELERY_RESULT_BACKEND=redis://${{Redis.REDISHOST}}:${{Redis.REDISPORT}}/3
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_CONCURRENCY=4

# =============================================================================
# SECURITY SETTINGS (Production)
# =============================================================================
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CORS & CSRF - Add your Railway domain and any custom domains
# CORS_ALLOWED_ORIGINS=https://your-app.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.railway.app

# =============================================================================
# AI PROVIDER API KEYS (Add your actual keys)
# =============================================================================

# OpenAI (Required for main AI features)
OPENAI_API_KEY=sk-...

# Anthropic (Optional - for Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Optional - for Gemini models)
GOOGLE_API_KEY=...

# DeepSeek (Optional - for DeepSeek models)
DEEPSEEK_API_KEY=...

# Groq (Optional - for fast inference)
GROQ_API_KEY=gsk_...

# Replicate (Optional - for image/video generation)
REPLICATE_API_KEY=...

# =============================================================================
# MEDIA GENERATION (Optional)
# =============================================================================

# Stability AI
STABILITY_API_KEY=...

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=...
VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Runway (Video Generation)
RUNWAY_API_KEY=...

# Giphy
GIPHY_API_KEY=...

# =============================================================================
# DATA APIS (For Spiders - Optional)
# =============================================================================

# Financial Data
POLYGON_API_KEY=...
ALPHA_VANTAGE_API_KEY=...
COINGECKO_API_KEY=...

# Sports/Betting Data
THE_ODDS_API_KEY=...

# News
NEWS_API_KEY=...

# =============================================================================
# PLATFORM CONFIGURATION
# =============================================================================
PLATFORM_NAME=Unified Donkey Betz

# URLs (Railway will auto-detect, but you can override)
# FRONTEND_URL=https://your-app.railway.app
# BACKEND_URL=https://your-app.railway.app
# WEBSOCKET_URL=wss://your-app.railway.app

# =============================================================================
# AGENT ORCHESTRATION
# =============================================================================
MAX_CONCURRENT_AGENTS=50
AGENT_TIMEOUT_SECONDS=300
ENABLE_CROSS_DOMAIN_AGENTS=True
AGENT_REGISTRY_CACHE_TTL=900

# =============================================================================
# SELF-AWARENESS & INTELLIGENCE
# =============================================================================
ENABLE_SELF_AWARENESS=True
ENABLE_CODE_EMBEDDING=True
ENABLE_SELF_MODIFICATION=False
SELF_AWARENESS_SCAN_INTERVAL=3600

# =============================================================================
# PERFORMANCE & MONITORING
# =============================================================================
ENABLE_PERFORMANCE_MONITORING=True
ENABLE_DETAILED_LOGGING=False
LOG_LEVEL=WARNING

# Sentry Error Tracking (Recommended)
# SENTRY_DSN=https://...@sentry.io/...

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_WEBSOCKETS=True
ENABLE_REAL_TIME_NOTIFICATIONS=True
ENABLE_BACKGROUND_TASKS=True
ENABLE_FILE_UPLOAD=True
ENABLE_API_DOCUMENTATION=True

# Development tools (keep disabled in production)
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SILK_PROFILING=False
TESTING_MODE=False
MOCK_EXTERNAL_APIS=False
