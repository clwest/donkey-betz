# DaVinci Bridge Server Configuration

# ============================================
# Server Settings
# ============================================
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=9090
DEBUG=true

# ============================================
# DaVinci Resolve Paths (Mac OS X)
# ============================================
RESOLVE_SCRIPT_API=/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting
RESOLVE_SCRIPT_LIB=/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so

# ============================================
# Security
# ============================================
# API key for authentication (set a strong random key for production)
API_KEY=dev-key-change-in-production

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# ============================================
# Render Settings
# ============================================
DEFAULT_RENDER_PATH=/tmp/davinci_renders
MAX_CONCURRENT_RENDERS=2

# Default render quality
DEFAULT_RESOLUTION=1920x1080
DEFAULT_CODEC=H264
DEFAULT_FORMAT=mp4

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/tmp/davinci_bridge.log
