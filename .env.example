# UNIFIED DONKEY BETZ PLATFORM CONFIGURATION
# Copy to .env and fill in your actual values

# Core Django Settings
SECRET_KEY=your-super-secret-django-key-here-min-50-chars
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=backend.settings

# Database Configuration
DATABASE_URL=postgresql://unified_user:secure_password@localhost:5432/unified_donkey_betz

# Redis Configuration (Different databases for different purposes)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_SESSION_URL=redis://localhost:6379/2
REDIS_CHANNELS_URL=redis://localhost:6379/3

# AI Provider API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
REPLICATE_API_KEY=your-replicate-api-key
MISTRAL_API_KEY=your-mistral-api-key
COHERE_API_KEY=your-cohere-api-key
GROQ_API_KEY=your-groq-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Image & Media Generation
STABILITY_API_KEY=your-stability-ai-key
ELEVENLABS_API_KEY=your-elevenlabs-key
VOICE_ID=21m00Tcm4TlvDq8ikWAM
GIPHY_API_KEY=your-giphy-key

# Sports & Financial APIs
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
POLYGON_API_KEY=your-polygon-key
SEC_API_KEY=your-sec-api-key
COINBASE_API_KEY=your-coinbase-key
COINBASE_PRIVATE_KEY=your-coinbase-private-key
ETHERSCAN_API_KEY=your-etherscan-key
COINGECKO_API_KEY=your-coingecko-key

# Communication Services
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
RESEND_API_KEY=your-resend-key
DEFAULT_FROM_EMAIL=hello@unified-donkey-betz.com

# Platform Configuration
PLATFORM_NAME=Unified Donkey Betz
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001
WEBSOCKET_URL=ws://localhost:8001

# Frontend Environment Variables (React/Vite)
VITE_API_URL=http://localhost:8001/api
VITE_MEDIA_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001
VITE_DBAO_API_URL=http://localhost:8001/api
VITE_DBAO_WS_URL=ws://localhost:8001
VITE_AUTH_TOKEN=your-auth-token-here
VITE_UCWSF_ENHANCED_CORS=true
VITE_UCWSF_WEBSOCKETS=true
VITE_UCWSF_CUSTOM_HEADERS=true
VITE_DBAO_ENABLED=true
VITE_DEBUG_MODE=true

# Mobile Environment Variables (React Native/Expo)
EXPO_PUBLIC_API_URL=http://localhost:8001/api
EXPO_PUBLIC_DONKEY_BETZ_API_URL=http://localhost:8001/api
EXPO_PUBLIC_WS_URL=ws://localhost:8001
EXPO_PUBLIC_DBAO_API_URL=http://localhost:8001
EXPO_PUBLIC_DBAO_WS_URL=ws://localhost:8001
EXPO_PUBLIC_AUTH_TOKEN=your-auth-token-here

# Self-Awareness & Intelligence
ENABLE_SELF_AWARENESS=True
ENABLE_CODE_EMBEDDING=True
ENABLE_SELF_MODIFICATION=False
SELF_AWARENESS_SCAN_INTERVAL=3600

# Agent Orchestration
MAX_CONCURRENT_AGENTS=100
AGENT_TIMEOUT_SECONDS=300
ENABLE_CROSS_DOMAIN_AGENTS=True
AGENT_REGISTRY_CACHE_TTL=900

# Performance & Monitoring
ENABLE_PERFORMANCE_MONITORING=True
ENABLE_DETAILED_LOGGING=True
LOG_LEVEL=INFO
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Production Security (set to True in production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_CONCURRENCY=4

# Sports Analytics
ENABLE_SPORTS_ANALYTICS=True
SPORTS_CONFIDENCE_THRESHOLD=0.6
SPORTS_MIN_EDGE=0.04
SPORTS_MAX_CONCURRENT_ANALYSES=5

# Content Generation
ENABLE_CONTENT_GENERATION=True
CONTENT_GENERATION_MAX_TOKENS=4000
CONTENT_GENERATION_TEMPERATURE=0.7

# Development & Testing
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SILK_PROFILING=False
TESTING_MODE=False
MOCK_EXTERNAL_APIS=False