TEST_AUTH_TOKEN=424a48280fa87d30f4997beda23ccad57418d7cb

# =============================================================================
# SCHEDULED DIAGNOSTIC AGENTS (Session 1093 / 1094)
# =============================================================================
# Three scheduled agents run daily and post anomaly reports to the governance
# inbox when threshold gates trip. All flags OFF by default — safe to enable
# individually. See core/services/scheduled_diagnostic_runner.py for the
# primitive; each diagnostic's config module documents its tunables in full.

# ── CTOAgent daily reliability diagnostic (core/services/diagnostics/cto_daily.py)
# CTO_DIAGNOSTIC_ENABLED=false
# CTO_DIAGNOSTIC_POSTING_ENABLED=false
# CTO_DIAG_FAILRATE_HIGH=0.06
# CTO_DIAG_FAILRATE_CRIT=0.10
# CTO_DIAG_DELTA_HIGH=0.02
# CTO_DIAG_MIN_TOTAL_24H=50
# CTO_DIAG_NEW_SIG_COUNT=5
# CTO_DIAG_AGENT_SPIKE_MIN=5
# CTO_DIAG_COOLDOWN_HOURS_HIGH=20
# CTO_DIAG_COOLDOWN_HOURS_CRIT=6

# ── COOAgent daily operations diagnostic (core/services/diagnostics/coo_daily.py)
# COO_DIAGNOSTIC_ENABLED=false
# COO_DIAGNOSTIC_POSTING_ENABLED=false
# COO_DIAG_VELOCITY_DROP_PCT=0.30
# COO_DIAG_VELOCITY_ABS_FLOOR=5
# COO_DIAG_REVIEW_AGE_HOURS=24
# COO_DIAG_OLDEST_REVIEW_HOURS=48
# COO_DIAG_JAM_READY_MIN=10
# COO_DIAG_ACTION_CRIT_MIN=2
# COO_DIAG_ACTION_CRIT_CRIT=5
# COO_DIAG_STUCK_HOURS=72
# COO_DIAG_STUCK_MIN=5
# COO_DIAG_STUCK_IGNORE_BEFORE=   # ISO date (e.g. 2026-03-16); excludes sediment older than this
# COO_DIAG_PUBLISHABLE_TYPES=    # DEPRECATED Session 1095. CSV of deliverable_types (legacy Session 1094 bridge). Prefer COO_DIAG_PUBLISH_INTENTS below.
# COO_DIAG_PUBLISH_INTENTS=publish_candidate,publish_required   # Recommended filter — scopes jam/velocity/review gates to intent-to-publish deliverables only. Skip to leave unfiltered.
# COO_DIAG_GATE_HANG_MIN=10      # pending gate_stuck HAI count → HIGH
# COO_DIAG_GATE_HANG_NEW_MIN=5   # new gate_stuck in 24h → HIGH (surge detector)
# COO_DIAG_REWORK_MIN=5          # backward status transitions in 24h → HIGH (moving fast but leaking quality)
# COO_DIAG_MYTHOLOGY_MIN=10      # unacked critical+high mythology alerts → HIGH
# COO_DIAG_MYTHOLOGY_CRIT=25     # unacked critical mythology alerts → CRITICAL
# COO_DIAG_DAILY_POST_CAP=2      # Session 1096 Rigby: conservative start. Bump to 3 after 1st week of real data.

# ── TrendAnalysis daily anomaly diagnostic (core/services/diagnostics/trend_analysis_daily.py)
# TREND_DIAGNOSTIC_ENABLED=false
# TREND_DIAGNOSTIC_POSTING_ENABLED=false
# TREND_DIAG_VOLUME_DROP_PCT_HIGH=0.50
# TREND_DIAG_VOLUME_DROP_PCT_CRIT=0.80
# TREND_DIAG_VOLUME_ABS_FLOOR=20
# TREND_DIAG_SILENT_SPIDER_MIN=5
# TREND_DIAG_CONCENTRATION_PCT=0.60
# TREND_DIAG_CLUSTER_SURGE_HIGH=3.0
# TREND_DIAG_CLUSTER_SURGE_CRIT=5.0
