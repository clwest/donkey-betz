# UNIFIED DONKEY BETZ PLATFORM CONFIGURATION
# Copy to .env and fill in your actual values

# Core Django Settings
SECRET_KEY=your-super-secret-django-key-here-min-50-chars
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=backend.settings

# Database Configuration
# Session 1094: uppercase token placeholders + example.com host so pre-commit
# secret-scanning hooks don't false-positive on the username:password pattern.
# The hook whitelists example.com (see .git/hooks/pre-commit). Replace each
# UPPERCASE_TOKEN with your actual values in .env (never commit real creds).
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@example.com:5432/DB_NAME

# Redis Configuration (Different databases for different purposes)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_SESSION_URL=redis://localhost:6379/2
REDIS_CHANNELS_URL=redis://localhost:6379/3

# AI Provider API Keys (NEVER commit real keys!)
# SECURITY WARNING: These are placeholders. Use a secure vault in production!
OPENAI_API_KEY=sk-...your-openai-key-here-REPLACE-ME
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key-here-REPLACE-ME
GOOGLE_API_KEY=AIza...your-google-key-here-REPLACE-ME
