# GPT-5 Configuration (Real model - Released August 2025)
DEFAULT_GPT5_MODEL=gpt-5-mini
GPT5_REASONING_LEVEL=medium
ENABLE_PROMPT_CACHING=True
PROMPT_CACHE_TTL=300
GPT5_FALLBACK_MODEL=gpt-4
ENABLE_GPT5_MIGRATION=True

# Self-Awareness & Intelligence
ENABLE_SELF_AWARENESS=True
ENABLE_CODE_EMBEDDING=True
ENABLE_SELF_MODIFICATION=False
SELF_AWARENESS_SCAN_INTERVAL=3600

# Agent Orchestration
MAX_CONCURRENT_AGENTS=100
AGENT_TIMEOUT_SECONDS=300
ENABLE_CROSS_DOMAIN_AGENTS=True
AGENT_REGISTRY_CACHE_TTL=900

# Performance & Monitoring
ENABLE_PERFORMANCE_MONITORING=True
ENABLE_DETAILED_LOGGING=True
LOG_LEVEL=INFO
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Production Security (set to True in production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_CONCURRENCY=4

# Sports Analytics
ENABLE_SPORTS_ANALYTICS=True
SPORTS_CONFIDENCE_THRESHOLD=0.6
SPORTS_MIN_EDGE=0.04
SPORTS_MAX_CONCURRENT_ANALYSES=5

# Content Generation
ENABLE_CONTENT_GENERATION=True
CONTENT_GENERATION_MAX_TOKENS=4000
CONTENT_GENERATION_TEMPERATURE=0.7

# GPT-5 Configuration
DEFAULT_GPT5_MODEL=gpt-5-mini
GPT5_REASONING_LEVEL=medium
ENABLE_PROMPT_CACHING=True
PROMPT_CACHE_TTL=300
GPT5_FALLBACK_MODEL=gpt-4
ENABLE_GPT5_MIGRATION=True

# Development & Testing
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SILK_PROFILING=False
TESTING_MODE=False
MOCK_EXTERNAL_APIS=False

# =============================================================================
# DOCKER AND CONTAINERIZATION
# =============================================================================

# Docker Registry Configuration
DOCKER_REGISTRY=ghcr.io/donkey-betz
DOCKER_IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=unified-donkey-betz

# Container Scaling
BACKEND_REPLICAS=3
FRONTEND_REPLICAS=2
CELERY_REPLICAS=4
MOBILE_REPLICAS=2

# =============================================================================
# PRODUCTION DEPLOYMENT
# =============================================================================

# Domain and SSL
DOMAIN=your-domain.com
SSL_EMAIL=admin@your-domain.com
HTTPS_ENABLED=True

# Production Database (PostgreSQL)
PROD_DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@example.com:5432/ai_unified_platform
PROD_DB_NAME=ai_unified_platform
PROD_DB_USER=unified_user
PROD_DB_PASSWORD=secure_prod_password
PROD_DB_HOST=prod-postgres
PROD_DB_PORT=5432

# Production Redis Configuration
PROD_REDIS_URL=redis://prod-redis:6379/0
PROD_REDIS_PASSWORD=secure_redis_password
PROD_REDIS_HOST=prod-redis
PROD_REDIS_PORT=6379

# Load Balancing
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=4096
NGINX_CLIENT_MAX_BODY_SIZE=100M

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Prometheus Configuration
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secure_grafana_password
GRAFANA_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource,grafana-piechart-panel

# ELK Stack Configuration
ELASTICSEARCH_HEAP_SIZE=1g
KIBANA_ENCRYPTION_KEY=your-kibana-encryption-key-32-chars
LOGSTASH_HEAP_SIZE=512m

# APM and Tracing
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
ENABLE_DISTRIBUTED_TRACING=True

# Application Performance Monitoring
APM_SERVER_URL=http://apm-server:8200
APM_SECRET_TOKEN=your-apm-secret-token

# =============================================================================
# SECURITY AND COMPLIANCE
# =============================================================================

# Production Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:
CSP_FONT_SRC='self' data:
CSP_CONNECT_SRC='self' ws: wss: http: https:

# Rate Limiting
RATE_LIMIT_API=10/s
RATE_LIMIT_LOGIN=1/s
RATE_LIMIT_REGISTER=1/m

# =============================================================================
# BACKUP AND DISASTER RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=unified-donkey-betz-backups
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key
BACKUP_S3_REGION=us-west-2

# Database Backup
DB_BACKUP_ENABLED=True
DB_BACKUP_COMPRESSION=True
DB_BACKUP_ENCRYPTION=True

# =============================================================================
# SCALING AND PERFORMANCE
# =============================================================================

# Database Connection Pooling
DB_CONN_MAX_AGE=60
DB_CONN_POOL_SIZE=20
DB_CONN_POOL_MAX_OVERFLOW=30

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_ENTRIES=10000
CACHE_EVICTION_POLICY=allkeys-lru

# CDN Configuration
CDN_ENABLED=True
CDN_URL=https://cdn.your-domain.com
CDN_STATIC_URL=${CDN_URL}/static/
CDN_MEDIA_URL=${CDN_URL}/media/

