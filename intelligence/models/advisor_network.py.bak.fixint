"""
Advisor Network Models - 25+ Expert Advisors with Verified Track Records
Implements Priority 4: Scale Advisor Network
"""

from django.db import models
from django.contrib.auth import get_user_model
from django.conf import settings
from django.utils import timezone
from typing import Dict, List, Optional
import json

class AdvisorCategory(models.Model):
    """Categories for organizing specialized advisors"""

    CATEGORY_TYPES = [
        ('SPORTS_BETTING', 'Sports Betting Experts'),
        ('CRYPTO', 'Crypto Analysts'),
        ('OPTIONS', 'Options Traders'),
        ('REAL_ESTATE', 'Real Estate Specialists'),
        ('FOREX', 'Forex Traders'),
        ('STOCKS', 'Stock Market Analysts'),
        ('COMMODITIES', 'Commodities Experts'),
        ('MACRO', 'Macro Economic Analysts'),
    ]

    name = models.CharField(max_length=50, choices=CATEGORY_TYPES, unique=True)
    display_name = models.CharField(max_length=100)
    description = models.TextField()
    icon = models.CharField(max_length=50, default='Users')
    color = models.CharField(max_length=7, default='#3B82F6')
    min_advisors = models.IntegerField(default=3)
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        app_label = 'intelligence_rt'
        db_table = 'advisor_categories'
        verbose_name_plural = "Advisor Categories"
        ordering = ['display_name']

    def __str__(self):
        return self.display_name


class AdvisorSpecialization(models.Model):
    """Specific specializations within categories"""

    category = models.ForeignKey(AdvisorCategory, on_delete=models.CASCADE, related_name='specializations')
    name = models.CharField(max_length=100)
    description = models.TextField()
    required_experience_years = models.IntegerField(default=2)
    verification_criteria = models.JSONField(default=dict)

    class Meta:
        app_label = 'intelligence_rt'
        db_table = 'advisor_specializations'
        unique_together = ['category', 'name']
        ordering = ['category', 'name']

    def __str__(self):
        return f"{self.category.display_name} - {self.name}"


class Advisor(models.Model):
    """Expert advisor with verified track record"""

    TRUST_LEVELS = [
        ('VERIFIED', 'Verified Expert'),
        ('HIGH', 'High Trust'),
        ('MEDIUM', 'Medium Trust'),
        ('PROBATION', 'Probationary'),
        ('PENDING', 'Pending Verification'),
    ]

    ADVISOR_TIERS = [
        ('PLATINUM', 'Platinum Elite'),
        ('GOLD', 'Gold Expert'),
        ('SILVER', 'Silver Specialist'),
        ('BRONZE', 'Bronze Analyst'),
        ('TRAINEE', 'Trainee'),
    ]

    # Basic Information
    user = models.OneToOneField(settings.AUTH_USER_MODEL, on_delete=models.CASCADE, null=True, blank=True)
    external_id = models.CharField(max_length=50, unique=True)
    name = models.CharField(max_length=100)
    title = models.CharField(max_length=200)
    bio = models.TextField()
    avatar_url = models.URLField(blank=True)

    # Expertise
    category = models.ForeignKey(AdvisorCategory, on_delete=models.PROTECT, related_name='advisors')
    specializations = models.ManyToManyField(AdvisorSpecialization, related_name='advisors')
    expertise_tags = models.JSONField(default=list)  # ["NBA Injuries", "Line Movement", etc.]

    # Verification & Trust
    trust_level = models.CharField(max_length=20, choices=TRUST_LEVELS, default='PENDING')
    tier = models.CharField(max_length=20, choices=ADVISOR_TIERS, default='TRAINEE')
    verification_date = models.DateTimeField(null=True, blank=True)
    verification_data = models.JSONField(default=dict)  # Store proof of track record

    # Performance Metrics
    reputation_score = models.DecimalField(max_digits=3, decimal_places=2, default=0.0)  # 0-5
    success_rate = models.DecimalField(max_digits=5, decimal_places=4, default=0.0)  # 0-1
    total_decisions = models.IntegerField(default=0)
    successful_decisions = models.IntegerField(default=0)
    roi_percentage = models.DecimalField(max_digits=8, decimal_places=2, default=0.0)

    # Specialization Metrics (for different domains)
    domain_performance = models.JSONField(default=dict)  # {"NBA": 0.72, "NFL": 0.68, etc.}

    # Activity
    is_active = models.BooleanField(default=True)
    is_online = models.BooleanField(default=False)
    last_seen = models.DateTimeField(default=timezone.now)
    joined_date = models.DateTimeField(auto_now_add=True)

    # Compensation & Stakes
    base_fee = models.DecimalField(max_digits=10, decimal_places=2, default=0.0)
    performance_fee_percentage = models.DecimalField(max_digits=5, decimal_places=2, default=0.0)
    total_earnings = models.DecimalField(max_digits=12, decimal_places=2, default=0.0)
    staking_limit = models.DecimalField(max_digits=12, decimal_places=2, default=1000.0)

    # Social Proof
    linkedin_url = models.URLField(blank=True)
    twitter_handle = models.CharField(max_length=50, blank=True)
    proof_urls = models.JSONField(default=list)  # Links to verified track records
    certifications = models.JSONField(default=list)

    class Meta:
        app_label = 'intelligence_rt'
        db_table = 'advisors'
        ordering = ['-reputation_score', '-success_rate']
        indexes = [
            models.Index(fields=['category', 'trust_level']),
            models.Index(fields=['tier', 'is_active']),
        ]

    def __str__(self):
        return f"{self.name} - {self.title}"

    def update_performance(self, decision_outcome: bool, domain: str = None):
        """Update advisor performance metrics"""
        self.total_decisions += 1
        if decision_outcome:
            self.successful_decisions += 1

        self.success_rate = self.successful_decisions / self.total_decisions

        if domain:
            if domain not in self.domain_performance:
                self.domain_performance[domain] = {'total': 0, 'successful': 0}

            self.domain_performance[domain]['total'] += 1
            if decision_outcome:
                self.domain_performance[domain]['successful'] += 1

            domain_rate = (self.domain_performance[domain]['successful'] /
                          self.domain_performance[domain]['total'])
            self.domain_performance[domain]['rate'] = round(domain_rate, 4)

        self.save()

    def calculate_tier(self):
        """Auto-calculate tier based on performance"""
        if self.success_rate >= 0.75 and self.total_decisions >= 100:
            return 'PLATINUM'
        elif self.success_rate >= 0.70 and self.total_decisions >= 50:
            return 'GOLD'
        elif self.success_rate >= 0.65 and self.total_decisions >= 25:
            return 'SILVER'
        elif self.success_rate >= 0.60 and self.total_decisions >= 10:
            return 'BRONZE'
        else:
            return 'TRAINEE'


class AdvisorVerification(models.Model):
    """Track record verification for advisors"""

    VERIFICATION_TYPES = [
        ('TRACK_RECORD', 'Historical Track Record'),
        ('PLATFORM', 'Platform Performance'),
        ('CERTIFICATION', 'Professional Certification'),
        ('SOCIAL_PROOF', 'Social Proof'),
        ('PEER_REVIEW', 'Peer Review'),
    ]

    advisor = models.ForeignKey(Advisor, on_delete=models.CASCADE, related_name='verifications')
    verification_type = models.CharField(max_length=30, choices=VERIFICATION_TYPES)
    verified_by = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True)
    verification_date = models.DateTimeField(auto_now_add=True)

    # Verification Details
    platform = models.CharField(max_length=100, blank=True)  # "Action Network", "Tipstrr", etc.
    record_url = models.URLField(blank=True)
    performance_data = models.JSONField(default=dict)

    # Metrics
    verified_roi = models.DecimalField(max_digits=8, decimal_places=2, null=True, blank=True)
    verified_win_rate = models.DecimalField(max_digits=5, decimal_places=4, null=True, blank=True)
    verified_picks_count = models.IntegerField(default=0)
    time_period_days = models.IntegerField(default=0)

    is_valid = models.BooleanField(default=True)
    notes = models.TextField(blank=True)

    class Meta:
        app_label = 'intelligence_rt'
        db_table = 'advisor_verifications'
        ordering = ['-verification_date']

    def __str__(self):
        return f"{self.advisor.name} - {self.get_verification_type_display()}"


class AdvisorCollaboration(models.Model):
    """Collaboration between multiple advisors on decisions"""

    STATUS_CHOICES = [
        ('DRAFT', 'Draft'),
        ('REVIEW', 'Under Review'),
        ('VOTING', 'Voting Phase'),
        ('DECIDED', 'Decision Made'),
        ('EXECUTED', 'Executed'),
        ('CLOSED', 'Closed'),
    ]

    title = models.CharField(max_length=200)
    description = models.TextField()
    domain = models.CharField(max_length=50)
    entity = models.CharField(max_length=100)

    creator = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.CASCADE, related_name='created_collaborations')
    advisors = models.ManyToManyField(Advisor, related_name='collaborations')

    status = models.CharField(max_length=20, choices=STATUS_CHOICES, default='DRAFT')
    created_at = models.DateTimeField(auto_now_add=True)
    deadline = models.DateTimeField(null=True, blank=True)

    # Consensus Metrics
    consensus_score = models.DecimalField(max_digits=5, decimal_places=4, default=0.0)
    confidence_score = models.DecimalField(max_digits=5, decimal_places=4, default=0.0)
    diversity_score = models.DecimalField(max_digits=5, decimal_places=4, default=0.0)

    # Decision
    final_decision = models.TextField(blank=True)
    decision_date = models.DateTimeField(null=True, blank=True)
    outcome = models.JSONField(default=dict)

    class Meta:
        app_label = 'intelligence_rt'
        db_table = 'advisor_collaborations'
        ordering = ['-created_at']

    def __str__(self):
        return f"{self.title} - {self.get_status_display()}"

    def calculate_consensus(self):
        """Calculate consensus among advisors"""
        votes = self.votes.all()
        if not votes:
            return 0.0

        approve_votes = votes.filter(vote='APPROVE').count()
        total_votes = votes.count()

        self.consensus_score = approve_votes / total_votes
        self.save()
        return self.consensus_score


class AdvisorVote(models.Model):
    """Individual advisor votes on collaborations"""

    VOTE_CHOICES = [
        ('APPROVE', 'Approve'),
        ('REJECT', 'Reject'),
        ('ABSTAIN', 'Abstain'),
    ]

    collaboration = models.ForeignKey(AdvisorCollaboration, on_delete=models.CASCADE, related_name='votes')
    advisor = models.ForeignKey(Advisor, on_delete=models.CASCADE, related_name='votes')

    vote = models.CharField(max_length=20, choices=VOTE_CHOICES)
    confidence = models.DecimalField(max_digits=5, decimal_places=4)  # 0-1
    reasoning = models.TextField()

    stake_amount = models.DecimalField(max_digits=10, decimal_places=2, default=0.0)
    timestamp = models.DateTimeField(auto_now_add=True)

    class Meta:
        app_label = 'intelligence_rt'
        unique_together = ['collaboration', 'advisor']
        ordering = ['-timestamp']

    def __str__(self):
        return f"{self.advisor.name} - {self.vote} on {self.collaboration.title}"


class AdvisorRecruitment(models.Model):
    """Pipeline for recruiting new advisors"""

    RECRUITMENT_STATUS = [
        ('IDENTIFIED', 'Identified'),
        ('CONTACTED', 'Contacted'),
        ('EVALUATING', 'Evaluating'),
        ('NEGOTIATING', 'Negotiating'),
        ('ONBOARDING', 'Onboarding'),
        ('ACTIVE', 'Active'),
        ('REJECTED', 'Rejected'),
        ('WITHDRAWN', 'Withdrawn'),
    ]

    # Candidate Information
    name = models.CharField(max_length=100)
    category = models.ForeignKey(AdvisorCategory, on_delete=models.CASCADE)
    specializations = models.JSONField(default=list)

    # Contact
    email = models.EmailField(blank=True)
    linkedin_url = models.URLField(blank=True)
    twitter_handle = models.CharField(max_length=50, blank=True)

    # Evaluation
    status = models.CharField(max_length=20, choices=RECRUITMENT_STATUS, default='IDENTIFIED')
    source = models.CharField(max_length=100)  # Where we found them
    verified_track_record = models.JSONField(default=dict)
    evaluation_notes = models.TextField(blank=True)

    # Process
    recruiter = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.SET_NULL, null=True)
    identified_date = models.DateTimeField(auto_now_add=True)
    last_contact = models.DateTimeField(null=True, blank=True)

    # If converted
    advisor = models.OneToOneField(Advisor, on_delete=models.SET_NULL, null=True, blank=True)

    class Meta:
        app_label = 'intelligence_rt'
        ordering = ['-identified_date']

    def __str__(self):
        return f"{self.name} - {self.get_status_display()}"