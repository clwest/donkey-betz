"""
Spider Army Database Models
Enhanced models for storing spider intelligence data and feeding agents/advisors
"""

from django.db import models
from django.contrib.auth import get_user_model
from django.core.serializers.json import DjangoJSONEncoder
from django.utils import timezone
from decimal import Decimal
import json

from core.models import UnifiedBaseModel
from agents.models import UnifiedAgentTemplate

User = get_user_model()


class SpiderIntelligenceNode(UnifiedBaseModel):
    """
    Enhanced intelligence node specifically for spider-collected data
    Connects to the broader intelligence system while tracking spider-specific metrics
    """

    # Spider identification
    spider_name = models.CharField(
        max_length=100,
        help_text="Name of the spider that collected this data"
    )

    spider_run_id = models.CharField(
        max_length=200,
        help_text="Unique identifier for the spider run"
    )

    # Data classification
    intelligence_type = models.CharField(
        max_length=50,
        choices=[
            ('job_opportunity', 'Job Opportunity'),
            ('financial', 'Financial Intelligence'),
            ('market_data', 'Market Data'),
            ('content_opportunity', 'Content Opportunity'),
            ('crypto', 'Cryptocurrency'),
            ('startup', 'Startup Intelligence'),
            ('macro_economic', 'Macro Economic'),
            ('innovation', 'Innovation Research'),
            ('sec_filing', 'SEC Filing'),
            ('news', 'News & Media'),
            ('social_trend', 'Social Media Trend'),
            ('video_trend', 'Video Trend'),
            ('newsletter_trend', 'Newsletter Trend'),
        ],
        help_text="Type of intelligence data"
    )

    # Source information
    source_url = models.URLField(
        max_length=500,
        help_text="Original URL where data was scraped"
    )

    source_platform = models.CharField(
        max_length=100,
        help_text="Platform/website source (e.g., 'upwork', 'yahoo_finance')"
    )

    # Core data
    raw_data = models.JSONField(
        help_text="Raw scraped data from the spider"
    )

    processed_data = models.JSONField(
        default=dict,
        help_text="Processed and enriched data"
    )

    # Quality metrics
    confidence_score = models.FloatField(
        default=0.5,
        help_text="Spider's confidence in data quality (0-1)"
    )

    relevance_scores = models.JSONField(
        default=dict,
        help_text="Relevance scores for different advisors/agents"
    )

    # Spider performance data
    extraction_time_ms = models.IntegerField(
        null=True,
        blank=True,
        help_text="Time taken to extract this data in milliseconds"
    )

    processing_metadata = models.JSONField(
        default=dict,
        help_text="Metadata about spider processing"
    )

    # Distribution tracking
    agents_notified = models.JSONField(
        default=list,
        help_text="List of agents that received this data"
    )

    advisors_notified = models.JSONField(
        default=list,
        help_text="List of advisors that received this data"
    )

    distribution_timestamp = models.DateTimeField(
        null=True,
        blank=True,
        help_text="When data was distributed to agents/advisors"
    )

    # Action tracking
    actions_taken = models.JSONField(
        default=list,
        help_text="Actions taken by agents based on this intelligence"
    )

    revenue_generated = models.DecimalField(
        max_digits=12,
        decimal_places=2,
        default=Decimal('0.00'),
        help_text="Revenue generated from opportunities found in this data"
    )

    # Freshness and validity
    data_freshness_hours = models.IntegerField(
        default=24,
        help_text="How fresh this data should be considered (in hours)"
    )

    is_stale = models.BooleanField(
        default=False,
        help_text="Whether this data is considered stale"
    )

    expires_at = models.DateTimeField(
        null=True,
        blank=True,
        help_text="When this data expires"
    )

    class Meta:
        app_label = 'intelligence_rt'
        verbose_name = "Spider Intelligence Node"
        verbose_name_plural = "Spider Intelligence Nodes"
        ordering = ['-created_at']
        indexes = [
            models.Index(fields=['spider_name']),
            models.Index(fields=['intelligence_type']),
            models.Index(fields=['source_platform']),
            models.Index(fields=['confidence_score']),
            models.Index(fields=['is_stale']),
            models.Index(fields=['created_at']),
        ]

    def __str__(self):
        return f"{self.spider_name} - {self.intelligence_type} ({self.confidence_score:.2f})"

    def mark_as_distributed(self, agents: list = None, advisors: list = None):
        """Mark data as distributed to agents/advisors"""
        if agents:
            self.agents_notified = list(set(self.agents_notified + agents))
        if advisors:
            self.advisors_notified = list(set(self.advisors_notified + advisors))

        self.distribution_timestamp = timezone.now()
        self.save()

    def add_action(self, agent_name: str, action_type: str, action_data: dict):
        """Record an action taken based on this intelligence"""
        action = {
            'agent_name': agent_name,
            'action_type': action_type,
            'action_data': action_data,
            'timestamp': timezone.now().isoformat()
        }
        self.actions_taken.append(action)
        self.save()

    def add_revenue(self, amount: Decimal, source: str):
        """Add revenue generated from this intelligence"""
        self.revenue_generated += amount
        self.add_action('system', 'revenue_generated', {
            'amount': str(amount),
            'source': source,
            'total_revenue': str(self.revenue_generated)
        })

    def calculate_roi(self) -> float:
        """Calculate ROI based on revenue generated vs processing cost"""
        # Simplified ROI calculation
        processing_cost = 0.01  # Assume 1 cent processing cost
        if processing_cost > 0:
            return float(self.revenue_generated) / processing_cost
        return 0.0

    def is_data_fresh(self) -> bool:
        """Check if data is still fresh based on freshness hours"""
        if self.expires_at:
            return timezone.now() < self.expires_at

        age_hours = (timezone.now() - self.created_at).total_seconds() / 3600
        return age_hours < self.data_freshness_hours


class SpiderPerformanceMetrics(UnifiedBaseModel):
    """
    Performance metrics for individual spiders
    """

    spider_name = models.CharField(
        max_length=100,
        unique=True,
        help_text="Name of the spider"
    )

    # Run statistics
    total_runs = models.PositiveIntegerField(
        default=0,
        help_text="Total number of spider runs"
    )

    successful_runs = models.PositiveIntegerField(
        default=0,
        help_text="Number of successful runs"
    )

    failed_runs = models.PositiveIntegerField(
        default=0,
        help_text="Number of failed runs"
    )

    # Data collection metrics
    total_items_scraped = models.PositiveIntegerField(
        default=0,
        help_text="Total items scraped across all runs"
    )

    total_data_distributed = models.PositiveIntegerField(
        default=0,
        help_text="Total data points distributed to agents"
    )

    unique_agents_fed = models.PositiveIntegerField(
        default=0,
        help_text="Number of unique agents that received data"
    )

    unique_advisors_fed = models.PositiveIntegerField(
        default=0,
        help_text="Number of unique advisors that received data"
    )

    # Performance metrics
    avg_execution_time_seconds = models.FloatField(
        default=0.0,
        help_text="Average execution time per run"
    )

    avg_items_per_run = models.FloatField(
        default=0.0,
        help_text="Average items scraped per run"
    )

    avg_confidence_score = models.FloatField(
        default=0.5,
        help_text="Average confidence score of scraped data"
    )

    # Business metrics
    total_revenue_generated = models.DecimalField(
        max_digits=12,
        decimal_places=2,
        default=Decimal('0.00'),
        help_text="Total revenue generated from this spider's data"
    )

    avg_revenue_per_item = models.DecimalField(
        max_digits=10,
        decimal_places=4,
        default=Decimal('0.0000'),
        help_text="Average revenue per scraped item"
    )

    # Error tracking
    error_count = models.PositiveIntegerField(
        default=0,
        help_text="Total number of errors encountered"
    )

    last_error_message = models.TextField(
        blank=True,
        help_text="Last error message encountered"
    )

    last_error_timestamp = models.DateTimeField(
        null=True,
        blank=True,
        help_text="When the last error occurred"
    )

    # Timing
    last_run_timestamp = models.DateTimeField(
        null=True,
        blank=True,
        help_text="When the spider last ran"
    )

    next_scheduled_run = models.DateTimeField(
        null=True,
        blank=True,
        help_text="When the spider is next scheduled to run"
    )

    # Configuration
    current_frequency_minutes = models.PositiveIntegerField(
        default=60,
        help_text="Current run frequency in minutes"
    )

    priority_level = models.IntegerField(
        default=5,
        help_text="Current priority level (1-10)"
    )

    class Meta:
        app_label = 'intelligence_rt'
        verbose_name = "Spider Performance Metrics"
        verbose_name_plural = "Spider Performance Metrics"
        ordering = ['-total_revenue_generated', '-total_items_scraped']

    def __str__(self):
        return f"{self.spider_name} - {self.total_runs} runs, ${self.total_revenue_generated}"

    def calculate_success_rate(self) -> float:
        """Calculate success rate percentage"""
        if self.total_runs == 0:
            return 0.0
        return (self.successful_runs / self.total_runs) * 100

    def calculate_roi(self) -> float:
        """Calculate return on investment"""
        # Simplified cost model: $0.01 per run
        total_cost = self.total_runs * 0.01
        if total_cost > 0:
            return float(self.total_revenue_generated) / total_cost
        return 0.0

    def update_from_run(self, success: bool, items_scraped: int, execution_time: float,
                       avg_confidence: float = None, revenue_generated: Decimal = None):
        """Update metrics from a spider run"""
        self.total_runs += 1

        if success:
            self.successful_runs += 1
        else:
            self.failed_runs += 1

        self.total_items_scraped += items_scraped
        self.last_run_timestamp = timezone.now()

        # Update averages
        if self.total_runs > 0:
            # Update average execution time
            total_time = self.avg_execution_time_seconds * (self.total_runs - 1) + execution_time
            self.avg_execution_time_seconds = total_time / self.total_runs

            # Update average items per run
            self.avg_items_per_run = self.total_items_scraped / self.total_runs

            # Update average confidence if provided
            if avg_confidence is not None:
                total_confidence = self.avg_confidence_score * (self.total_runs - 1) + avg_confidence
                self.avg_confidence_score = total_confidence / self.total_runs

        # Update revenue
        if revenue_generated:
            self.total_revenue_generated += revenue_generated
            if self.total_items_scraped > 0:
                self.avg_revenue_per_item = self.total_revenue_generated / self.total_items_scraped

        self.save()


class AgentIntelligenceFeed(UnifiedBaseModel):
    """
    Track intelligence feeds to specific agents
    """

    agent_name = models.CharField(
        max_length=200,
        help_text="Name of the agent receiving intelligence"
    )

    agent_template = models.ForeignKey(
        UnifiedAgentTemplate,
        null=True,
        blank=True,
        on_delete=models.SET_NULL,
        related_name='intelligence_feeds'
    )

    intelligence_node = models.ForeignKey(
        SpiderIntelligenceNode,
        on_delete=models.CASCADE,
        related_name='agent_feeds'
    )

    # Feed timing
    delivered_at = models.DateTimeField(
        auto_now_add=True,
        help_text="When intelligence was delivered to agent"
    )

    processed_at = models.DateTimeField(
        null=True,
        blank=True,
        help_text="When agent processed the intelligence"
    )

    # Agent response
    agent_action = models.CharField(
        max_length=100,
        blank=True,
        help_text="Action taken by agent based on this intelligence"
    )

    agent_response_data = models.JSONField(
        default=dict,
        help_text="Agent's response/output data"
    )

    # Performance tracking
    relevance_score = models.FloatField(
        default=0.5,
        help_text="How relevant was this intelligence to the agent"
    )

    action_success = models.BooleanField(
        null=True,
        blank=True,
        help_text="Whether the agent's action was successful"
    )

    value_generated = models.DecimalField(
        max_digits=10,
        decimal_places=2,
        default=Decimal('0.00'),
        help_text="Value/revenue generated from this intelligence"
    )

    class Meta:
        app_label = 'intelligence_rt'
        verbose_name = "Agent Intelligence Feed"
        verbose_name_plural = "Agent Intelligence Feeds"
        ordering = ['-delivered_at']
        indexes = [
            models.Index(fields=['agent_name']),
            models.Index(fields=['delivered_at']),
            models.Index(fields=['relevance_score']),
        ]

    def __str__(self):
        return f"{self.agent_name} <- {self.intelligence_node.spider_name} ({self.relevance_score:.2f})"

    def mark_processed(self, action: str, response_data: dict = None, success: bool = None):
        """Mark intelligence as processed by agent"""
        self.processed_at = timezone.now()
        self.agent_action = action
        if response_data:
            self.agent_response_data = response_data
        if success is not None:
            self.action_success = success
        self.save()


class AdvisorIntelligenceFeed(UnifiedBaseModel):
    """
    Track intelligence feeds to advisor personalities
    """

    advisor_name = models.CharField(
        max_length=200,
        help_text="Name of the advisor personality"
    )

    intelligence_node = models.ForeignKey(
        SpiderIntelligenceNode,
        on_delete=models.CASCADE,
        related_name='advisor_feeds'
    )

    # Feed timing
    delivered_at = models.DateTimeField(
        auto_now_add=True
    )

    # Advisor-specific scoring
    advisor_relevance_score = models.FloatField(
        help_text="Relevance score for this specific advisor"
    )

    investment_recommendation = models.CharField(
        max_length=50,
        choices=[
            ('strong_buy', 'Strong Buy'),
            ('buy', 'Buy'),
            ('hold', 'Hold'),
            ('sell', 'Sell'),
            ('strong_sell', 'Strong Sell'),
            ('watch', 'Watch'),
            ('ignore', 'Ignore'),
        ],
        blank=True,
        help_text="Advisor's investment recommendation"
    )

    advisor_analysis = models.JSONField(
        default=dict,
        help_text="Advisor's analysis of the intelligence"
    )

    # Strategy alignment
    strategy_alignment_score = models.FloatField(
        default=0.5,
        help_text="How well this intelligence aligns with advisor's strategy"
    )

    risk_assessment = models.CharField(
        max_length=20,
        choices=[
            ('very_low', 'Very Low'),
            ('low', 'Low'),
            ('medium', 'Medium'),
            ('high', 'High'),
            ('very_high', 'Very High'),
        ],
        blank=True,
        help_text="Risk level assessed by advisor"
    )

    class Meta:
        app_label = 'intelligence_rt'
        verbose_name = "Advisor Intelligence Feed"
        verbose_name_plural = "Advisor Intelligence Feeds"
        ordering = ['-advisor_relevance_score', '-delivered_at']
        indexes = [
            models.Index(fields=['advisor_name']),
            models.Index(fields=['advisor_relevance_score']),
            models.Index(fields=['delivered_at']),
        ]

    def __str__(self):
        return f"{self.advisor_name} <- {self.intelligence_node.spider_name} ({self.advisor_relevance_score:.2f})"


class SpiderArmyStatus(UnifiedBaseModel):
    """
    Overall status and health monitoring for the spider army
    """

    status_snapshot_id = models.CharField(
        max_length=100,
        unique=True,
        help_text="Unique identifier for this status snapshot"
    )

    # Army overview
    total_spiders_deployed = models.PositiveIntegerField(
        default=0,
        help_text="Total number of spiders in the army"
    )

    active_spiders = models.PositiveIntegerField(
        default=0,
        help_text="Number of currently active spiders"
    )

    dormant_spiders = models.PositiveIntegerField(
        default=0,
        help_text="Number of dormant/inactive spiders"
    )

    # Performance aggregates
    total_runs_today = models.PositiveIntegerField(
        default=0,
        help_text="Total spider runs today"
    )

    total_items_scraped_today = models.PositiveIntegerField(
        default=0,
        help_text="Total items scraped today"
    )

    total_data_distributed_today = models.PositiveIntegerField(
        default=0,
        help_text="Total data points distributed today"
    )

    # Quality metrics
    avg_army_confidence_score = models.FloatField(
        default=0.5,
        help_text="Average confidence score across all spiders"
    )

    army_success_rate = models.FloatField(
        default=0.0,
        help_text="Overall army success rate percentage"
    )

    # Business metrics
    total_revenue_today = models.DecimalField(
        max_digits=12,
        decimal_places=2,
        default=Decimal('0.00'),
        help_text="Total revenue generated today"
    )

    # Agent/advisor feeding stats
    agents_fed_today = models.PositiveIntegerField(
        default=0,
        help_text="Number of agents fed data today"
    )

    advisors_fed_today = models.PositiveIntegerField(
        default=0,
        help_text="Number of advisors fed data today"
    )

    # System health
    system_health_score = models.FloatField(
        default=1.0,
        help_text="Overall system health score (0-1)"
    )

    error_count_today = models.PositiveIntegerField(
        default=0,
        help_text="Number of errors today"
    )

    # Detailed breakdown
    spider_status_breakdown = models.JSONField(
        default=dict,
        help_text="Detailed status of each spider"
    )

    performance_alerts = models.JSONField(
        default=list,
        help_text="Active performance alerts"
    )

    class Meta:
        app_label = 'intelligence_rt'
        verbose_name = "Spider Army Status"
        verbose_name_plural = "Spider Army Status Reports"
        ordering = ['-created_at']

    def __str__(self):
        return f"Army Status {self.created_at.strftime('%Y-%m-%d %H:%M')} - {self.active_spiders}/{self.total_spiders_deployed} active"

    def calculate_reality_score(self) -> float:
        """Calculate the reality score (how real/functional the spider army is)"""
        factors = []

        # Spider deployment factor
        if self.total_spiders_deployed > 0:
            deployment_factor = min(1.0, self.total_spiders_deployed / 20)  # Target 20+ spiders
            factors.append(deployment_factor * 0.2)

        # Activity factor
        if self.total_spiders_deployed > 0:
            activity_factor = self.active_spiders / self.total_spiders_deployed
            factors.append(activity_factor * 0.3)

        # Data collection factor
        data_factor = min(1.0, self.total_items_scraped_today / 1000)  # Target 1000+ items/day
        factors.append(data_factor * 0.2)

        # Distribution factor
        distribution_factor = min(1.0, self.total_data_distributed_today / 500)  # Target 500+ distributions/day
        factors.append(distribution_factor * 0.15)

        # Revenue factor
        revenue_factor = min(1.0, float(self.total_revenue_today) / 100)  # Target $100+/day
        factors.append(revenue_factor * 0.15)

        return sum(factors) if factors else 0.0