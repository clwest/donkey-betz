# EAS Build — ignore files not needed for native builds.
# This file MUST live at the git root (not mobile/).
# EAS re-installs node_modules on the server.

# Mobile dependencies + build output
mobile/node_modules/
mobile/dist/
mobile/.expo/

# Backend (not needed for mobile builds)
.venv/
venv/
venv_ml/
__pycache__/
*.pyc
core/
ai_core/
frontend/
docs/
tools/
scripts/
templates/
static/
staticfiles/
*.sqlite3
*.log
*.pid
manage.py
Makefile
Procfile
requirements*.txt
runtime.txt
nixpacks.toml
docker-compose*.yml
Dockerfile
*.toml
discord_bot/
resolve_node/
.claude/

# Large data directories (not needed for mobile builds)
media/
backups/
logs/
_archived/
external-project-docs/
pgvector_local_repo/
intelligence/
income_builder_outputs/
models/
content/
archive/
review/
tests/

# Dev tooling
.vscode/
.idea/
.git/

# Cache / data files
*.pkl
.rag/
.rag_cache.pkl

# Test files
__tests__/
*.test.ts
*.test.tsx
coverage/

# macOS cruft
.DS_Store
